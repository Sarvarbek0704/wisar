# ─── EMAIL (Gmail SMTP) ────────────────────────────────────────────────────────
# Gmail: Account → Security → 2-Step Verification → App passwords → "Mail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-16-chars"
SMTP_FROM="Mana Platform <your-email@gmail.com>"

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ─── MONITORING ───────────────────────────────────────────────────────────────
# Sentry: sentry.io → New Project → DSN
SENTRY_DSN=""

# Plausible Analytics (GDPR-friendly, bepul): plausible.io → Sites
