# ─── DATABASE ─────────────────────────────────────────────────────────────────
# PostgreSQL — Neon.tech bepul tier: neon.tech → New Project → Connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Lokal dev uchun (psql o'rnatilgan bo'lsa):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/wisar?schema=public"

# ─── SERVER ───────────────────────────────────────────────────────────────────
API_PORT=4000
# Ilova vaqt mintaqasi — streak, kunlik faollik va cron'lar shunga qarab hisoblanadi.
# Bo'sh bo'lsa "Asia/Tashkent". UTC ishlatilsa kun chegarasi 5 soatga siljiydi.
APP_TZ="Asia/Tashkent"
# Cron vazifalari shu nusxada ishlasinmi (bir nechta API nusxasi bo'lsa faqat bittasida 1).
# Bo'sh = yoqilgan.
CRON_ENABLED=1
NEXT_PUBLIC_API_URL="http://localhost:4000"
# NODE_ENV=production  # prod'da o'rnatiladi — JWT/CORS fail-fast va standalone uchun
# CORS oq ro'yxati — vergul bilan ajratilgan domenlar (prod'da MAJBURIY).
# Bo'sh bo'lsa: dev'da localhost, prod'da hech kim (barcha bloklanadi).
CORS_ORIGINS="http://localhost:3001"

# ─── KONTENT ──────────────────────────────────────────────────────────────────
CONTENT_DIR="../Dasturlash_Kitobi"
ENGLISH_DIR="../Ingliz_Tili_Kursi"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Kamida 32 tasodifiy belgi — production'da o'zgartirish MAJBURIY
JWT_SECRET="change-me-in-production-at-least-32-chars"

# ─── AI IELTS COACH ───────────────────────────────────────────────────────────
# Anthropic (Claude): console.anthropic.com → API keys
ANTHROPIC_API_KEY=""

# Bepul AI (BITTASINI tanlang):
# Groq (tavsiya): console.groq.com
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY=""
LLM_MODEL="llama-3.3-70b-versatile"
# AI so'rovi uchun timeout (ms). Timeout'siz provayder osilib qolsa so'rov cheksiz kutadi.
LLM_TIMEOUT_MS=60000
LLM_STREAM_TIMEOUT_MS=180000

# Google Gemini: aistudio.google.com/apikey
# LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# LLM_API_KEY=""
# LLM_MODEL="gemini-2.0-flash"

# ─── EMAIL (Gmail SMTP) ────────────────────────────────────────────────────────
# Gmail: Account → Security → 2-Step Verification → App passwords → "Mail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-16-chars"
SMTP_FROM="Wisar <your-email@gmail.com>"

# ─── TELEGRAM (telefon raqamini tasdiqlash) ───────────────────────────────────
# SMS o'rniga Telegram: Eskiz SMS xizmatini faqat yuridik shaxsga beradi, Telegram
# esa bepul va raqamning haqiqiyligini o'zi kafolatlaydi ("Raqamni ulashish" tugmasi).
# Sozlash: bash ~/.claude/bin/wisar-telegram  (@BotFather dan token oling)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Webhook so'rovi haqiqatan Telegram'dan kelganini tekshirish uchun.
# Production'da MAJBURIY — bo'sh bo'lsa webhook rad etiladi.
TELEGRAM_WEBHOOK_SECRET=""

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ─── MONITORING ───────────────────────────────────────────────────────────────
# Sentry: sentry.io → New Project → DSN
SENTRY_DSN=""

# Plausible Analytics (GDPR-friendly, bepul): plausible.io → Sites
# Bo'sh qoldiring — skript yuklanmaydi
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ─── IDEALLASHTIRISH SPEC YANGI ENV ────────────────────────────────────────────
# Anthropic model (ixtiyoriy — fallback Claude modeli)
ANTHROPIC_MODEL="claude-sonnet-5"

# RAG embeddings (18-vazifa) — OpenAI-mos /embeddings.
# Masalan OpenAI: EMBED_BASE_URL="https://api.openai.com/v1" EMBED_MODEL="text-embedding-3-small"
# yoki Google: EMBED_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/" EMBED_MODEL="text-embedding-004"
EMBED_BASE_URL=""
EMBED_API_KEY=""
EMBED_MODEL="text-embedding-3-small"

# Speaking audio → transcript (20-vazifa) — OpenAI-mos /audio/transcriptions (Whisper).
# Masalan Groq: WHISPER_BASE_URL="https://api.groq.com/openai/v1" WHISPER_MODEL="whisper-large-v3"
# Bo'sh bo'lsa — Speaking faqat transcript oqimiga qaytadi (fallback).
WHISPER_BASE_URL=""
WHISPER_API_KEY=""
WHISPER_MODEL="whisper-large-v3"

# Kesh (36-vazifa): CACHE_DEBUG=1 → kesh HIT/MISS log. REDIS_URL (ixtiyoriy, hozircha ishlatilmaydi).
CACHE_DEBUG=""
REDIS_URL=""

# SEO (39-vazifa) — sitemap/robots/og uchun saytning to'liq manzili (production'da o'zgartiring)
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
