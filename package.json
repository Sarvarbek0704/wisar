{
  "name": "wisar-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Mavzu-agnostik o'quv/kontent platformasi — Next.js + NestJS + PostgreSQL",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @wisar/database",
    "db:migrate": "npm run migrate -w @wisar/database",
    "db:seed": "npm run seed -w @wisar/database",
    "db:seed:flashcards": "npm run seed:flashcards -w @wisar/database",
    "db:index": "npm run index -w @wisar/database",
    "db:reset": "npm run reset -w @wisar/database",
    "build:web": "npm run build -w @wisar/web",
    "build:api": "npm run build -w @wisar/api",
    "setup": "npm install && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@nestjs/passport": "^11.0.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "^10.62.0",
    "@sentry/nextjs": "^10.62.0",
    "framer-motion": "^12.42.0",
    "helmet": "^8.2.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}
