{
  "name": "@wisar/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --name init",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:english": "tsx prisma/seed-english.ts",
    "seed:flashcards": "tsx prisma/seed-flashcards.ts",
    "index": "dotenv -e ../../.env -- tsx prisma/index-embeddings.ts",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
