// Mavzu-agnostik kontent modeli:
//   Topic (mavzu)  ->  Section (qism/bo'lim)  ->  Article (bob/maqola, markdown)
// Bu model dasturlash kitobi uchun ham, kelajakda ISTALGAN boshqa mavzu uchun ham ishlaydi.

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (Neon.tech yoki boshqa PG provider).
// .env da: DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
// Neon.tech bepul tier: neon.tech → New Project → Connection string ni oling.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Foydalanuvchi (auth, admin, progress, bookmark uchun)
model User {
  id             String          @id @default(cuid())
  /// Email YOKI telefon bo'lishi shart (kodda tekshiriladi — Prisma buni ifodalay olmaydi).
  /// Telefon bilan ro'yxatdan o'tgan foydalanuvchida email bo'lmasligi mumkin.
  email          String?         @unique
  /// Normallashtirilgan ko'rinish: 998901234567 (common/phone.ts)
  phone          String?         @unique
  name           String?
  passwordHash   String
  googleId       String?         @unique
  /// Telegram foydalanuvchi ID'si — raqamni tasdiqlagan hisob
  telegramId     String?         @unique
  /// "admin" yoki "user"
  role           String          @default("user")
  /// Email tasdiqlangan-yo'qligi (qat'iy verification)
  emailVerified  Boolean         @default(false)
  /// Telefon Telegram orqali tasdiqlanganmi
  phoneVerified  Boolean         @default(false)
  phoneLinkTokens PhoneLinkToken[]
  /// Onboarding aniqlagan CEFR daraja: "A1".."C2" (10,32-vazifa)
  cefrLevel        String?
  /// Kunlik maqsad (daqiqa) (4-vazifa)
  dailyGoalMinutes Int           @default(10)
  /// 2FA TOTP secret (base32) — yoqilgan bo'lsa to'ldiriladi (40-vazifa)
  twoFactorSecret  String?
  twoFactorEnabled Boolean       @default(false)
  /// Haftalik hisobot xatini olishni xohlaydimi (obunani bekor qilish)
  emailOptIn       Boolean       @default(true)
  progress       Progress[]
  bookmarks      Bookmark[]
  notes          Note[]
  comments       Comment[]
  streak         Streak?
  plannerDays    PlannerDay[]
  plannerHabits  PlannerHabits?
  passwordResets PasswordReset[]
  emailVerifications EmailVerification[]
  flashcardReviews FlashcardReview[]
  dailyActivity    DailyActivity[]
  reviewItems      ReviewItem[]
  highlights       Highlight[]
  refreshTokens    RefreshToken[]
  groupsOwned      Group[]         @relation("GroupsOwned")
  groupMemberships GroupMember[]   @relation("GroupMemberships")
  forumThreads     ForumThread[]
  forumPosts       ForumPost[]
  commentLikes     CommentLike[]
  ieltsAttempts    IeltsAttempt[]
  aiThreads        AiThread[]
  notifications    Notification[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/// In-app bildirishnoma (46-vazifa) — takror-tekshir, forum javobi, guruh, yangi kontent, sertifikat, tizim.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "review_due" | "forum_reply" | "group" | "content" | "certificate" | "system"
  type      String
  title     String
  body      String?
  /// Bosilganda o'tiladigan ichki havola (masalan "/forum/123")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

/// O'qilgan boblar (progress tracking)
model Progress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  completed Boolean  @default(true)
  /// O'qish pozitsiyasi (0..1) — "davom etish" uchun (5-vazifa)
  scrollPct Float?
  updatedAt DateTime @updatedAt

  @@unique([userId, articleId])
  @@index([articleId])
}

/// Saqlangan (bookmark) maqolalar
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([articleId])
}

/// Shaxsiy eslatmalar (maqolaga)
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([articleId])
}

/// Mavzu — eng yuqori daraja (masalan "Dasturlash kitobi", yoki istalgan boshqa soha)
model Topic {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  /// Lucide ikonka nomi (emoji emas) — masalan "book-open", "wrench"
  icon        String?
  /// Aksent rang (HEX) — mavzu uchun maxsus, ixtiyoriy
  accent      String?
  order       Int       @default(0)
  published   Boolean   @default(true)
  sections    Section[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
}

/// Bo'lim (QISM) — mavzu ichidagi guruh
model Section {
  id        String    @id @default(cuid())
  topicId   String
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  icon      String?
  order     Int       @default(0)
  articles  Article[]
  quizzes   Quiz[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([topicId, slug])
  @@index([topicId, order])
}

/// Maqola (bob) — markdown kontent
model Article {
  id          String    @id @default(cuid())
  sectionId   String
  section     Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  /// Asosiy kontent — markdown (renderer HTML va premium ikonkaga aylantiradi)
  content     String
  /// Qisqa tavsif (ixtiyoriy, ro'yxat/SEO uchun)
  excerpt     String?
  order       Int       @default(0)
  /// Taxminiy o'qish vaqti (daqiqa)
  readingTime Int       @default(0)
  published   Boolean   @default(true)
  progress    Progress[]
  bookmarks   Bookmark[]
  notes       Note[]
  comments    Comment[]
  highlights     Highlight[]
  chunks         ArticleChunk[]
  articleQuizzes Quiz[]      @relation("ArticleQuizzes")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sectionId, slug])
  @@index([sectionId, order])
}

/// Izoh (maqola muhokamasi) — thread (reply) + like (28-vazifa)
model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  /// Reply (1 daraja) — null bo'lsa ildiz izoh (28-vazifa)
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Comment[] @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([parentId])
  @@index([userId])
}

/// Interaktiv test (bo'limga bog'liq; ixtiyoriy ravishda aniq maqolaga ham)
model Quiz {
  id        String     @id @default(cuid())
  sectionId String
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  /// Article-level quiz (8-vazifa) — to'ldirilgan bo'lsa maqola oxiri testi
  articleId String?
  article   Article?   @relation("ArticleQuizzes", fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  order     Int        @default(0)
  questions Question[]
  createdAt DateTime   @default(now())

  @@index([sectionId, order])
  @@index([articleId])
}

/// Test savoli
model Question {
  id           String  @id @default(cuid())
  quizId       String
  quiz         Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text         String
  /// JSON: ["variant1","variant2",...]
  options      String
  correctIndex Int
  explanation  String?
  order        Int     @default(0)

  @@index([quizId])
}

// ─── YANGI MODELLAR ────────────────────────────────────────────────────────────

/// Kundalik o'qish seriyasi (streak)
model Streak {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  current     Int       @default(0)
  longest     Int       @default(0)
  /// Oxirgi checkin sanasi "YYYY-MM-DD" formatida
  lastCheckin String?
  /// Streak freeze / repair (14-vazifa)
  freezes        Int     @default(2)
  lastFreezeDate String?
  updatedAt   DateTime  @updatedAt
}

/// Kunlik rejalashtiruvchi (planner) — kun ma'lumotlari serverda
model PlannerDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD" formatida
  date      String
  /// JSON: { blocks: Block[], tasks: Task[], note: string }
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

/// Planner odatlari (habits) — foydalanuvchiga bir yozuv
model PlannerHabits {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// JSON: Habit[]
  habits    String   @default("[]")
  /// JSON: Record<date, Record<habitId, boolean>>
  log       String   @default("{}")
  updatedAt DateTime @updatedAt
}

/// Taklif kodlari (invite links)
model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  /// Invite yaratgan admin ID
  createdBy String
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

/// Parolni tiklash tokenlari
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Telefonni Telegram orqali tasdiqlash uchun bir martalik token.
///
/// Oqim: sayt token yaratadi → foydalanuvchi `t.me/<bot>?start=<token>` ga o'tadi
/// → botda "Raqamni ulashish" tugmasini bosadi → Telegram BOTGA haqiqiy raqamni
/// yuboradi → biz tokendan qaysi hisob ekanini bilib, raqamni tasdiqlaymiz.
///
/// Ya'ni foydalanuvchi hech qanday kod termaydi va raqam haqiqiyligini
/// Telegram'ning o'zi kafolatlaydi.
model PhoneLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Foydalanuvchi botda /start bosgach yoziladi. Raqam keyinroq alohida
  /// xabar bilan kelgani uchun, o'sha chatni tokenga bog'lab qo'yishimiz kerak.
  chatId    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([chatId])
}

/// Email tasdiqlash kodlari (6 xonali)
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Lug'at flashcard dastalari (daraja bo'yicha)
model FlashcardDeck {
  id        String      @id @default(cuid())
  slug      String      @unique
  title     String
  /// CEFR darajasi: "A1", "A2", "B1", "B2", "C1", "C2", "maxsus"
  level     String
  cards     Flashcard[]
  createdAt DateTime    @default(now())

  @@index([level])
}

/// Flashcard — lug'at kartasi
model Flashcard {
  id      String  @id @default(cuid())
  deckId  String
  deck    FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  /// Inglizcha so'z / ibora
  front   String
  /// O'zbekcha tarjima
  back    String
  ipa     String?
  example String?
  /// So'z turkumi: n, v, adj, adv, prep, conj, det, pron...
  pos     String?
  order   Int     @default(0)
  reviews FlashcardReview[]

  @@index([deckId])
}

/// SM-2 spaced repetition: foydalanuvchining har bir karta uchun holati
model FlashcardReview {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId     String
  card       Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// SM-2 sifat bahosi 0-5
  quality    Int       @default(3)
  /// Keyingi takrorlashgacha kunlar soni
  interval   Int       @default(1)
  easeFactor Float     @default(2.5)
  /// Ketma-ket to'g'ri javoblar soni — kanonik SM-2 uchun (ReviewItem bilan bir xil)
  reps       Int       @default(0)
  nextReview DateTime  @default(now())
  reviewedAt DateTime  @default(now())

  @@unique([userId, cardId])
  @@index([userId, nextReview])
  @@index([cardId])
}

// ─── IDEALLASHTIRISH SPEC YANGI MODELLARI ──────────────────────────────────────

/// Kunlik faollik — daily goal, streak heatmap, analitika manbai (4,30,31-vazifa)
model DailyActivity {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String // "YYYY-MM-DD"
  minutes        Int    @default(0)
  articlesRead   Int    @default(0)
  cardsReviewed  Int    @default(0)
  quizzesTaken   Int    @default(0)
  xp             Int    @default(0) // kelajak XP uchun joy (hozir to'ldirilmaydi)

  @@unique([userId, date])
  @@index([userId, date])
}

/// Umumiy takrorlash navbati (SM-2) — flashcard + xato quiz savollari bitta navbatda (7-vazifa)
model ReviewItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String   // "card" | "question"
  refId      String   // Flashcard.id yoki Question.id
  interval   Int      @default(1)
  easeFactor Float    @default(2.5)
  reps       Int      @default(0)
  nextReview DateTime @default(now())
  reviewedAt DateTime @default(now())

  @@unique([userId, kind, refId])
  @@index([userId, nextReview])
}

/// Maqola matnidagi belgilash + inline izoh (24-vazifa)
model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  quote     String   // belgilangan matn
  prefix    String?  // anchorlash uchun oldidagi ~20 belgi
  note      String?  // ixtiyoriy izoh
  color     String   @default("yellow")
  createdAt DateTime @default(now())

  @@index([userId, articleId])
  @@index([articleId])
}

/// RAG uchun maqola bo'laklari + embedding (18-vazifa)
/// pgvector mavjud emas — embedding String (JSON float[]) sifatida saqlanadi, cosine Node'da.
model ArticleChunk {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  ord       Int
  content   String
  embedding String  // JSON: number[]

  @@index([articleId])
}

/// AI suhbat tarixi — multi-turn tutor + roleplay (17,19-vazifa)
model AiThread {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String      // "tutor" | "roleplay"
  articleId String?     // tutor uchun
  scenario  String?     // roleplay senariysi
  messages  AiMessage[]
  createdAt DateTime    @default(now())

  @@index([userId])
}

model AiMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([threadId])
}

/// IELTS urinishlari serverda (20,30-vazifa)
model IeltsAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     String   // "writing" | "speaking" | "reading" | "listening"
  part      String?  // "1" | "2" | "3"
  band      Float
  detail    String   // JSON: to'liq natija
  createdAt DateTime @default(now())

  @@index([userId, skill, createdAt])
}

/// Refresh token (34-vazifa) — httpOnly cookie'da saqlanadi, DB'da hash
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// O'quv guruhlari (27-vazifa)
model Group {
  id        String        @id @default(cuid())
  name      String
  code      String        @unique // qo'shilish kodi
  ownerId   String
  owner     User          @relation("GroupsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  createdAt DateTime      @default(now())

  @@index([ownerId])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// Comment like (28-vazifa)
model CommentLike {
  id        String  @id @default(cuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

/// Q&A forum (29-vazifa)
model ForumThread {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  posts     ForumPost[]
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([userId])
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  accepted  Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([threadId])
  @@index([userId])
}

/// Admin audit log (40-vazifa)
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String   // "delete_user" | "delete_comment" | ...
  target    String?
  meta      String?  // JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Foydalanuvchi fikr-mulohazasi (feedback) — hamma yozadi, admin ko'radi.
/// Kim yozgani (name/email) snapshot sifatida saqlanadi — foydalanuvchi o'chsa ham qoladi.
model Feedback {
  id        String   @id @default(cuid())
  /// Kirgan foydalanuvchi bo'lsa ID (havola uchun; majburiy emas)
  userId    String?
  /// Kim yozgani (kirgan bo'lsa hisobdan, mehmon bo'lsa o'zi kiritadi)
  name      String?
  email     String?
  /// "like" | "dislike" | "suggestion" | "bug" | "feature" | "other"
  category  String   @default("other")
  message   String
  /// Qaysi sahifadan yuborilgani (ixtiyoriy kontekst)
  page      String?
  /// Admin o'qidimi
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@index([createdAt])
}
